# Copy this file to info.env (same folder). The addresses and domains below
# are the company's shared, non-secret settings and can stay as they are.
# Logins and passwords are personal: leave them empty here and enter your
# own in the console ("Вход и настройки"), which saves them to info.env.
# info.env is gitignored — never commit real credentials.

CRM_BASE_URL=https://crm.astana-motors.kz/
CRM_LOGIN=
CRM_PASSWORD=

WEBITEL_ALMATY_BASE_URL=https://wtl-alm.astana-motors.kz
WEBITEL_DOMAIN=mycar-almaty.astana-motors.kz
WEBITEL_LOGIN=
WEBITEL_PASSWORD=

WEBITEL_ASTANA_BASE_URL=https://wtl-ast.astana-motors.kz
WEBITEL_ASTANA_DOMAIN=mycar.astana-motors.kz
WEBITEL_ASTANA_LOGIN=
WEBITEL_ASTANA_PASSWORD=

# Optional. Empty = "Обновить список ожидающих" lists approvals assigned to
# you and to every CRM role you belong to. Set it only to watch one specific
# user/role (a SysAdminUnit Id).
CRM_VISA_OWNER_ID=

# --- Shared console on a server (optional) ---
# Leave these empty for a console on your own computer: it then listens on
# 127.0.0.1 only. CONSOLE_SHARED=1 makes it a console several people open in
# their browsers: it looks and works the same, but each browser keeps its
# own CRM/Webitel logins and sessions (under operators/), invisible to
# others. Listening beyond 127.0.0.1 requires CONSOLE_SHARED=1 and HTTPS.
CONSOLE_SHARED=
CONSOLE_HOST=
CONSOLE_PORT=
# Certificate and key (PEM), relative to the project folder, e.g. tls/console.crt
CONSOLE_TLS_CERT=
CONSOLE_TLS_KEY=
